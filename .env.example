# Copy to .env.local for local development. Never commit real values.
#
# Local Supabase (after `npx supabase start`): run `npx supabase status -o env` and use
#   API_URL          -> NEXT_PUBLIC_SUPABASE_URL          (http://127.0.0.1:54321)
#   PUBLISHABLE_KEY  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...)
#
# Hosted Supabase: Dashboard -> Project Settings -> Data API (URL) and API Keys (publishable key).
# Configure the same two variables in Vercel for Preview and Production.
#
# Both values are browser-safe. Authorization comes from the user's session plus RLS.
# Do NOT add a service-role or secret key to this app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
