# Copy to .env.local for local development. Never commit real values.
#
# Local Supabase (after `npm run db:start`): copy only the two NEXT_PUBLIC_ lines printed by
#   npx supabase status -o env --override-name api.url=NEXT_PUBLIC_SUPABASE_URL,auth.publishable_key=NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# (http://127.0.0.1:54321 and sb_publishable_...). Ignore the secret keys it also prints.
#
# Hosted Supabase: Dashboard -> Project Settings -> Data API (URL) and API Keys (publishable key).
# Configure the same two variables in Vercel for Preview and Production.
#
# Both values are browser-safe. Authorization comes from the user's session plus RLS.
# Do NOT add a service-role or secret key to this app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only (never prefix it with NEXT_PUBLIC_): the public origin for email confirmation
# links, which point to <origin>/auth/callback. Leave it unset locally, where http://localhost:3000 is
# used, and on Vercel, where VERCEL_PROJECT_PRODUCTION_URL (Production) or VERCEL_URL (Preview) is used.
# Set it when the app is served from a different origin. It must be an http:// or https:// URL; any path
# is ignored. Add <origin>/auth/callback to the Supabase Auth redirect URLs too. In a production build
# with none of these set, signup sends no redirect URL and Supabase falls back to its own Site URL.
# SITE_URL=https://launchpad.example.com
